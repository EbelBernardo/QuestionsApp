@using Perguntas.Client.Services
@inject ThemeService ThemeService
@inject AuthService AuthService
@inject NavigationManager Navigation

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">Perguntas</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable"
     onclick="if(event.target.closest('a.nav-link')) document.querySelector('.navbar-toggler').click()">


    <nav class="nav flex-column menu-content flex-grow-1">

        <div class="nav-item px-3">

            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">

                <i class="bi bi-house-door-fill"></i>

                <span>Home</span>

            </NavLink>

        </div>


    </nav>


    <div class="settings-area">

        <div class="nav-item px-3">

            @if (AuthService.IsAuthenticated && !string.IsNullOrWhiteSpace(userName))
            {
                <div class="nav-item px-3 user-profile">
                    <div class="nav-link">
                        <i class="bi bi-person-circle"></i>

                        <span>@userName</span>
                    </div>
                </div>
            }

            <button class="nav-link settings-button" @onclick="ToggleSettings">

                <i class="bi bi-gear-fill"></i>

                <span>
                    Configurações
                </span>

                <i class="bi @(showSettings ? "bi-chevron-up" : "bi-chevron-down") ms-auto"></i>

            </button>

        </div>


        @if (showSettings)
        {
            <div class="settings-content">

                <div class="theme-option">

                    <span>
                        Tema
                    </span>


                    <label class="theme-switch">

                        <input type="checkbox" checked="@dark" @onchange="ChangeTheme" />

                        <span class="slider">
                            <span class="icon"></span>
                        </span>

                    </label>

                </div>

            </div>
        }

        @if (AuthService.IsAuthenticated)
        {
            <div class="nav-item px-3">

                <button class="nav-link settings-button" @onclick="LogoutAsync">

                    <i class="bi bi-box-arrow-right"></i>

                    <span>
                        Sair
                    </span>

                </button>

            </div>
        }

    </div>

</div>


@code {

    private bool dark;

    private bool showSettings;

    private string? userName;

    protected override async Task OnInitializedAsync()
    {
        if (AuthService.IsAuthenticated)
        {
            var profile = await AuthService.GetCurrentProfileAsync();

            userName = profile?.Name;
        }
    }

    private void ToggleSettings()
    {
        showSettings = !showSettings;
    }

    private async Task ChangeTheme(ChangeEventArgs e)
    {
        dark = (bool)e.Value!;

        await ThemeService.SetTheme(
            dark ? "theme-dark" : "theme-light"
        );
    }

    private async Task LogoutAsync()
    {
        await AuthService.LogoutAsync();

        Navigation.NavigateTo("/login");
    }

}