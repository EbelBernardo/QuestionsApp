@*
    ══════════════════════════════════════════════════════════════════════════
    Pages/Register.razor — MODEL-A-ATELIE
    ──────────────────────────────────────────────────────────────────────────
    Rota INALTERADA: "/register"
    Layout NOVO: AuthLayout

    ── LÓGICA PRESERVADA — LINHA POR LINHA ───────────────────────────────────
      · classe RegisterModel com os mesmos DataAnnotations
      · EditForm Model="_model" OnValidSubmit="RegisterAsync"
      · verificação Password != ConfirmPassword com a mesma mensagem
      · RegisterAsync() → AuthService.RegisterAsync(Name, Email, Password)
      · mesma mensagem de erro, mesmo try/catch/finally, mesmo _loading
      · Navigation.NavigateTo("/") em caso de sucesso

    ── ADIÇÃO PURAMENTE VISUAL ───────────────────────────────────────────────
      Medidor de força de senha. É contagem de caracteres no próprio
      componente — não valida nada, não bloqueia o envio, não muda regra.
      Se não quiser, apague o bloco .qa-strength e o método PasswordStrength.
    ══════════════════════════════════════════════════════════════════════════
*@
@page "/register"
@layout AuthLayout

@using Perguntas.Client.Services
@inject AuthService AuthService
@inject NavigationManager Navigation

<PageTitle>Criar conta · QuestionsApp</PageTitle>

<div class="qa-auth__box">

    <h1>Criar conta</h1>
    <p class="qa-auth__lead">Só o essencial — leva menos de um minuto.</p>

    <EditForm Model="_model" OnValidSubmit="RegisterAsync">

        <DataAnnotationsValidator />

        @if (!string.IsNullOrWhiteSpace(_errorMessage))
        {
            <div class="qa-alert qa-alert--danger" role="alert">
                <svg class="qa-ico" aria-hidden="true"><use href="#i-alert"></use></svg>
                <span>@_errorMessage</span>
            </div>
        }

        <div class="qa-field">
            <label class="qa-label" for="qa-reg-name">Nome</label>
            <InputText class="qa-input"
                       id="qa-reg-name"
                       autocomplete="name"
                       placeholder="Como podemos te chamar?"
                       @bind-Value="_model.Name" />
            <ValidationMessage For="@(() => _model.Name)" />
        </div>

        <div class="qa-field">
            <label class="qa-label" for="qa-reg-email">Email</label>
            <InputText class="qa-input"
                       id="qa-reg-email"
                       type="email"
                       autocomplete="email"
                       placeholder="voce@email.com"
                       @bind-Value="_model.Email" />
            <ValidationMessage For="@(() => _model.Email)" />
        </div>

        <div class="qa-field">
            <label class="qa-label" for="qa-reg-password">Senha</label>
            <InputText class="qa-input"
                       id="qa-reg-password"
                       type="password"
                       autocomplete="new-password"
                       placeholder="mínimo 6 caracteres"
                       @bind-Value="_model.Password" />

            @* Indicador visual — não interfere na validação *@
            <div class="qa-strength" aria-hidden="true">
                @for (var i = 1; i <= 4; i++)
                {
                    <i class="@(PasswordStrength >= i ? "is-on" : "")"></i>
                }
            </div>

            <ValidationMessage For="@(() => _model.Password)" />
        </div>

        <div class="qa-field">
            <label class="qa-label" for="qa-reg-confirm">Confirmar senha</label>
            <InputText class="qa-input"
                       id="qa-reg-confirm"
                       type="password"
                       autocomplete="new-password"
                       placeholder="repita a senha"
                       @bind-Value="_model.ConfirmPassword" />
            <ValidationMessage For="@(() => _model.ConfirmPassword)" />
        </div>

        <button class="qa-btn qa-btn--primary qa-btn--lg qa-btn--block"
                type="submit"
                disabled="@_loading"
                style="margin-top:8px">
            @if (_loading)
            {
                <span class="qa-spinner" aria-hidden="true"></span>
                <span>Cadastrando…</span>
            }
            else
            {
                <span>Criar conta</span>
            }
        </button>

    </EditForm>

    <p class="qa-auth__switch">
        Já possui uma conta?
        <a href="/login">Entrar</a>
    </p>

</div>

@code {
    private readonly RegisterModel _model = new();

    private bool _loading;
    private string _errorMessage = string.Empty;

    /// <summary>
    /// Indicador visual de força (0 a 4). Não valida nada.
    /// </summary>
    private int PasswordStrength
    {
        get
        {
            var p = _model.Password;

            if (string.IsNullOrEmpty(p))
                return 0;

            var score = 0;

            if (p.Length >= 6) score++;
            if (p.Length >= 10) score++;
            if (p.Any(char.IsDigit)) score++;
            if (p.Any(char.IsLetter) && p.Any(c => !char.IsLetterOrDigit(c))) score++;

            return score;
        }
    }

    private async Task RegisterAsync()
    {
        _errorMessage = string.Empty;
        _loading = true;

        try
        {
            if (_model.Password != _model.ConfirmPassword)
            {
                _errorMessage = "As senhas não coincidem.";
                return;
            }

            var success = await AuthService.RegisterAsync(
                _model.Name,
                _model.Email,
                _model.Password);

            if (!success)
            {
                _errorMessage = "Não foi possível criar a conta.";
                return;
            }

            Navigation.NavigateTo("/");
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private class RegisterModel
    {
        [System.ComponentModel.DataAnnotations.Required]
        public string Name { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required]
        [System.ComponentModel.DataAnnotations.EmailAddress]
        public string Email { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required]
        public string Password { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required]
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}
