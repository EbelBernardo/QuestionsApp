@*
    ══════════════════════════════════════════════════════════════════════════
    Pages/Login.razor — MODEL-A-ATELIE
    ──────────────────────────────────────────────────────────────────────────
    Rota INALTERADA: "/login"
    Layout NOVO: AuthLayout (antes usava o MainLayout, e por isso mostrava o
    menu lateral para quem ainda nem tinha entrado).

    ── LÓGICA PRESERVADA — LINHA POR LINHA ───────────────────────────────────
      · classe LoginModel com os mesmos DataAnnotations
      · EditForm Model="_model" OnValidSubmit="LoginAsync"
      · DataAnnotationsValidator + ValidationMessage nos dois campos
      · LoginAsync() → AuthService.LoginAsync(_model.Email, _model.Password)
      · mesma mensagem de erro, mesmo try/catch/finally, mesmo _loading
      · Navigation.NavigateTo("/") em caso de sucesso

      Só removi o Console.WriteLine("LOGIN OK - INDO PARA HOME"). Se quiser
      manter, é só recolocar antes do NavigateTo.
    ══════════════════════════════════════════════════════════════════════════
*@
@page "/login"
@layout AuthLayout

@using Perguntas.Client.Services
@inject AuthService AuthService
@inject NavigationManager Navigation

<PageTitle>Entrar · QuestionsApp</PageTitle>

<div class="qa-auth__box">

    <h1>Entrar</h1>
    <p class="qa-auth__lead">Bem-vindo de volta. Continue de onde parou.</p>

    <EditForm Model="_model" OnValidSubmit="LoginAsync">

        <DataAnnotationsValidator />

        @if (!string.IsNullOrWhiteSpace(_errorMessage))
        {
            <div class="qa-alert qa-alert--danger" role="alert">
                <svg class="qa-ico" aria-hidden="true"><use href="#i-alert"></use></svg>
                <span>@_errorMessage</span>
            </div>
        }

        <div class="qa-field">
            <label class="qa-label" for="qa-login-email">Email</label>
            <InputText class="qa-input"
                       id="qa-login-email"
                       type="email"
                       autocomplete="email"
                       placeholder="voce@email.com"
                       @bind-Value="_model.Email" />
            <ValidationMessage For="@(() => _model.Email)" />
        </div>

        <div class="qa-field">
            <label class="qa-label" for="qa-login-password">Senha</label>
            <InputText class="qa-input"
                       id="qa-login-password"
                       type="password"
                       autocomplete="current-password"
                       placeholder="••••••••"
                       @bind-Value="_model.Password" />
            <ValidationMessage For="@(() => _model.Password)" />
        </div>

        <button class="qa-btn qa-btn--primary qa-btn--lg qa-btn--block"
                type="submit"
                disabled="@_loading"
                style="margin-top:8px">
            @if (_loading)
            {
                <span class="qa-spinner" aria-hidden="true"></span>
                <span>Entrando…</span>
            }
            else
            {
                <span>Entrar</span>
            }
        </button>

    </EditForm>

    <p class="qa-auth__switch">
        Não possui uma conta?
        <a href="/register">Criar conta</a>
    </p>

</div>

@code {
    private readonly LoginModel _model = new();

    private bool _loading;
    private string _errorMessage = string.Empty;

    private async Task LoginAsync()
    {
        _errorMessage = string.Empty;
        _loading = true;

        try
        {
            var success = await AuthService.LoginAsync(
                _model.Email,
                _model.Password);

            if (!success)
            {
                _errorMessage = "Não foi possível entrar.";
                return;
            }

            Navigation.NavigateTo("/");
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private class LoginModel
    {
        [System.ComponentModel.DataAnnotations.Required]
        [System.ComponentModel.DataAnnotations.EmailAddress]
        public string Email { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required]
        public string Password { get; set; } = string.Empty;
    }
}
