@page "/questions/{Id:guid}"
@attribute [Authorize]
@using Perguntas.Client.Models
@using Perguntas.Client.Services
@using Microsoft.AspNetCore.Authorization

@inject QuestionService QuestionService
@inject CategoryService CategoryService

<div class="container mt-4">

    <h3 class="mb-4">@_category.Name</h3>

    <div class="card shadow-sm mb-4">
        <div class="card-body">

            <EditForm Model="_question" OnValidSubmit="CreateQuestion">

                <div class="mb-3">
                    <label class="form-label">Pergunta</label>
                    <InputTextArea class="form-control" @bind-Value="_question.Statement" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Resposta</label>
                    <InputTextArea class="form-control" @bind-Value="_question.Answer" />
                </div>

                <button class="btn btn-outline-primary" type="submit">
                    Criar Pergunta
                </button>

            </EditForm>

        </div>
    </div>

    @if (_questions.Count == 0)
    {
        <div class="alert alert-info">
            Nenhuma pergunta cadastrada.
        </div>
    }
    else
    {
        @foreach (var question in _questions)
        {
            <div class="card mb-3 shadow-sm">
                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-center mb-2">

                        <h5 class="card-title mb-0">
                            @question.Statement
                        </h5>

                        <button class="btn btn-link p-0 eye-button" @onclick="() => ToggleAnswer(question.ID)">

                            @if (_visibleAnswers.Contains(question.ID))
                            {
                                <i class="bi bi-eye"></i>
                            }
                            else
                            {
                                <i class="bi bi-eye-slash"></i>
                            }

                        </button>

                    </div>

                    @if (_visibleAnswers.Contains(question.ID))
                    {
                        <p class="card-text">
                            @question.Answer
                        </p>
                    }

                    <div class="d-flex justify-content-between align-items-center">

                        <div>
                            <button class="btn btn-outline-primary me-2" @onclick="() => OpenEditModal(question)">
                                Editar
                            </button>

                            <button class="btn btn-outline-danger" @onclick="() => DeleteQuestion(question.ID)">
                                Excluir
                            </button>
                        </div>

                        <div>
                            <span class="card-text me-2">
                                @question.CorrectAnswers/@question.TimesAnswered
                            </span>

                            @if (question.LastAnswerCorrect)
                            {
                                <span class="answer-status correct"></span>
                            }
                            else
                            {
                                <span class="answer-status incorrect"></span>
                            }
                        </div>

                    </div>

                </div>
            </div>
        }
    }

</div>

@if (showEditModal && editingQuestion is not null)
{
    <div class="modal-background">

        <div class="modal-box">

            <h4>Editar Pergunta</h4>


            <label>Pergunta</label>

            <InputTextArea class="form-control mb-3" @bind-Value="editingQuestion.Statement" />


            <label>Resposta</label>

            <InputTextArea class="form-control mb-3" @bind-Value="editingQuestion.Answer" />


            <button class="btn btn-outline-secondary" @onclick="CloseEditModal">
                Cancelar
            </button>


            <button class="btn btn-outline-primary" @onclick="SaveEdit">
                Salvar
            </button>

        </div>

    </div>
}

@code {

    [Parameter]
    public Guid Id { get; set; }

    private List<Question> _questions = [];
    private Question _question = new();
    private Category _category = new();

    private bool showEditModal;
    private Question? editingQuestion;

    private HashSet<Guid> _visibleAnswers = [];

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        await GetQuestions();
        _category = await CategoryService.GetAsync(Id) ?? new();

        StateHasChanged();
    }

    protected async Task<List<Question>> GetQuestions()
    {
        _questions = await QuestionService.GetAllAsync(Id);

        StateHasChanged();

        return _questions;
    }

    protected async Task CreateQuestion()
    {
        _question.CategoryID = Id;
        _question.CreatedAt = DateTime.UtcNow;

        await QuestionService.CreateAsync(_question);

        _question = new();

        await GetQuestions();
    }

    protected async Task DeleteQuestion(Guid id)
    {
        await QuestionService.DeleteAsync(id);

        await GetQuestions();
    }

    private void OpenEditModal(Question question)
    {
        editingQuestion = new Question
        {
            ID = question.ID,
            Statement = question.Statement,
            Answer = question.Answer,
            CategoryID = question.CategoryID,
            CreatedAt = question.CreatedAt
        };

        showEditModal = true;
    }


    private void CloseEditModal()
    {
        showEditModal = false;
        editingQuestion = null;
    }


    private async Task SaveEdit()
    {
        if (editingQuestion is null)
            return;

        await QuestionService.UpdateAsync(editingQuestion);

        showEditModal = false;
        editingQuestion = null;

        await GetQuestions();
    }

    private void ToggleAnswer(Guid id)
    {
        if (!_visibleAnswers.Add(id))
            _visibleAnswers.Remove(id);
    }
}
