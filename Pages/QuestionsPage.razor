@*
    ══════════════════════════════════════════════════════════════════════════
    Pages/QuestionsPage.razor — MODEL-A-ATELIE
    (cards de pergunta com faixa superior colorida = ideia do MODEL-C)
    ──────────────────────────────────────────────────────────────────────────
    Rota INALTERADA: "/questions/{Id:guid}"

    ── LÓGICA PRESERVADA (mesmos nomes, mesmos corpos) ───────────────────────
      · [Parameter] Id
      · OnAfterRenderAsync(firstRender) → GetQuestions() + SubjectService.GetAsync(Id)
      · GetQuestions()   → QuestionService.GetAllAsync(Id)
      · CreateQuestion() → QuestionService.CreateAsync(_question)
      · DeleteQuestion() → QuestionService.DeleteAsync(id)
      · OpenEditModal / CloseEditModal / SaveEdit → QuestionService.UpdateAsync
      · ToggleAnswer(id) → _visibleAnswers

    ── SOBRE A COR DA FAIXA SUPERIOR ─────────────────────────────────────────
      A faixa lê TimesAnswered / CorrectAnswers / LastAnswerCorrect, que já
      vêm carregados no objeto Question e que a tela antiga já exibia como
      "9/11". É mapeamento de apresentação, não cálculo novo — por isso está
      implementado. Se preferir centralizar isso, mova StatusOf() para onde
      quiser; a UI só depende do valor de retorno.

    ── ONDE CONECTAR DADOS DEPOIS ────────────────────────────────────────────
      Procure por "TODO(dados)". Os agregados do painel lateral estão como
      ganchos no final do arquivo.
    ══════════════════════════════════════════════════════════════════════════
*@
@page "/questions/{Id:guid}"
@attribute [Authorize]
@using Questions.Models
@using Questions.Services
@using Questions.Components
@using Microsoft.AspNetCore.Authorization

@inject QuestionService QuestionService
@inject SubjectService SubjectService
@inject TopicService TopicService
@inject NavigationManager Navigation


<PageTitle>@(string.IsNullOrWhiteSpace(_subject.Name) ? "Perguntas" : _subject.Name) · QuestionsApp</PageTitle>

<div class="qa-page" style="@UiHelpers.SubjectStyle(Id)">

    @* ═══════════════════ PAINEL CONTEXTUAL ═══════════════════ *@
    <aside class="qa-context">

        <div>
            <span class="qa-eyebrow">Matéria</span>

            <div class="qa-row" style="margin-top:10px">
                <div class="qa-mark qa-mark--lg" aria-hidden="true">
                    @UiHelpers.Initials(_subject.Name)
                </div>
                <h2 class="qa-context__title" style="margin:0;font-size:19px">
                    @_subject.Name
                </h2>
            </div>

            <p class="qa-context__desc">
                @if (_questions.Count == 0)
                {
                    <span>Nenhuma pergunta cadastrada ainda.</span>
                }
                else if (_questions.Count == 1)
                {
                    <span>1 pergunta cadastrada.</span>
                }
                else
                {
                    <span>@_questions.Count perguntas cadastradas.</span>
                }
            </p>
        </div>

        @if (_questions.Count > 0)
        {
            <button type="button" class="qa-btn qa-btn--primary qa-btn--block" @onclick="Study">
                <svg class="qa-ico" aria-hidden="true"><use href="#i-layers"></use></svg>
                Iniciar estudo
            </button>
        }

        @*
            ── ESTATÍSTICAS DA MATÉRIA ───────────────────────────────────────
            Mesmos componentes (.qa-stat) que a futura tela de Dashboard vai
            reutilizar. Enquanto os ganchos devolverem null, mostram "—".
        *@
        <div class="qa-statgrid qa-statgrid--2">

            <div class="qa-stat">
                <span class="qa-stat__value">@_questions.Count</span>
                <span class="qa-stat__label">Perguntas</span>
            </div>

            <div class="qa-stat qa-stat--teal">
                <span class="qa-stat__value">@(GetMastery() is int m ? $"{m}%" : "—")</span>
                <span class="qa-stat__label">Acerto</span>
            </div>

            <div class="qa-stat qa-stat--danger">
                <span class="qa-stat__value">@(GetWrongCount()?.ToString() ?? "—")</span>
                <span class="qa-stat__label">Errei</span>
            </div>

            <div class="qa-stat qa-stat--warning">
                <span class="qa-stat__value">@(GetNeverAnsweredCount()?.ToString() ?? "—")</span>
                <span class="qa-stat__label">Novas</span>
            </div>

        </div>

        @* TODO(dados): busca dentro da matéria — filtrar _questions em memória *@
        <label class="qa-search">
            <svg class="qa-ico" aria-hidden="true"><use href="#i-search"></use></svg>
            <input type="search" placeholder="Buscar pergunta…" aria-label="Buscar pergunta" disabled />
        </label>

        @* TODO(dados): filtros por estado — usar StatusOf(question) para filtrar *@
        <div class="qa-filters">
            <button type="button" class="qa-filter is-active">
                <span class="qa-filter__dot" style="background:var(--qa-primary)"></span>
                Todas
                <span class="qa-filter__count">@_questions.Count</span>
            </button>
            <button type="button" class="qa-filter" disabled>
                <span class="qa-filter__dot" style="background:var(--qa-danger)"></span>
                Errei na última
                <span class="qa-filter__count">@(GetWrongCount()?.ToString() ?? "—")</span>
            </button>
            <button type="button" class="qa-filter" disabled>
                <span class="qa-filter__dot" style="background:var(--qa-warning)"></span>
                Nunca respondidas
                <span class="qa-filter__count">@(GetNeverAnsweredCount()?.ToString() ?? "—")</span>
            </button>
        </div>

        @* ── SUBMATÉRIAS ───────────────────────────────────────────────
             Reaproveita .qa-filters, o mesmo componente dos filtros acima.
             O botão de engrenagem abre o diálogo de gerenciamento. *@
        <div class="qa-row qa-row--between" style="margin-top:18px">
            <span class="qa-eyebrow">Submatérias</span>
            <button type="button"
                    class="qa-btn qa-btn--icon"
                    @onclick="OpenTopics"
                    aria-label="Gerenciar submatérias">
                <svg class="qa-ico" aria-hidden="true"><use href="#i-gear"></use></svg>
            </button>
        </div>

        <div class="qa-filters" style="margin-top:8px">

            <button type="button"
                    class="qa-filter @(_filterKind == TopicFilterKind.All ? "is-active" : "")"
                    @onclick="ShowAllTopics">
                <span class="qa-filter__dot" style="background:var(--qa-primary)"></span>
                Todas
                <span class="qa-filter__count">@_questions.Count</span>
            </button>

            @foreach (var topic in _topics)
            {
                var isActive = _filterKind == TopicFilterKind.One && _filterTopicId == topic.ID;
                var topicCount = _questions.Count(q => q.TopicID == topic.ID);

                <button type="button"
                        class="qa-filter @(isActive ? "is-active" : "")"
                        @onclick="() => FilterByTopic(topic.ID)">
                    <span class="qa-filter__dot" style="background:var(--qa-subject)"></span>
                    @topic.Name
                    <span class="qa-filter__count">@topicCount</span>
                </button>
            }

            @if (_topics.Count > 0 && _questions.Any(q => q.TopicID is null))
            {
                <button type="button"
                        class="qa-filter @(_filterKind == TopicFilterKind.None ? "is-active" : "")"
                        @onclick="FilterWithoutTopic">
                    <span class="qa-filter__dot" style="background:var(--qa-text-3)"></span>
                    Sem submatéria
                    <span class="qa-filter__count">@_questions.Count(q => q.TopicID is null)</span>
                </button>
            }

            @if (_topics.Count == 0)
            {
                <p class="qa-hint" style="margin-top:6px">
                    Nenhuma submatéria ainda. Use a engrenagem para criar a primeira.
                </p>
            }

        </div>

        <div class="qa-context__foot">
            <a class="qa-btn qa-btn--ghost qa-btn--block" href="">
                <svg class="qa-ico" aria-hidden="true"><use href="#i-chevron-left"></use></svg>
                Voltar para Matérias
            </a>
        </div>

    </aside>


    @* ═══════════════════ PALCO ═══════════════════ *@
    <main class="qa-stage">

        <div class="qa-mtop">
            <a class="qa-btn qa-btn--icon" href="" aria-label="Voltar para Matérias">
                <svg class="qa-ico" aria-hidden="true"><use href="#i-chevron-left"></use></svg>
            </a>
            <h2>@_subject.Name</h2>
        </div>

        <div class="qa-sheet">

            <header class="qa-pagehead">
                <div>
                    @* A tela antiga não tinha nenhuma forma de voltar. *@
                    <nav class="qa-crumb" aria-label="Trilha">
                        <a href="">Matérias</a>
                        <span aria-hidden="true">/</span>
                        <span class="qa-crumb__current">@_subject.Name</span>
                    </nav>

                    <h1 class="qa-pagehead__title">Perguntas</h1>
                    <p class="qa-pagehead__sub">
                        Escreva a pergunta e a resposta. Elas viram cards no modo de estudo.
                    </p>
                </div>

                @if (_questions.Count > 0)
                {
                    <button type="button" class="qa-btn qa-btn--primary" @onclick="Study">
                        <svg class="qa-ico" aria-hidden="true"><use href="#i-layers"></use></svg>
                        Estudar
                    </button>
                }
            </header>

            @* ── FORMULÁRIO DE CRIAÇÃO (lógica intacta) ─────────────────── *@
            <EditForm Model="_question" OnValidSubmit="CreateQuestion">

                <div class="qa-plate">

                    <div class="qa-formgrid">

                        <div class="qa-field">
                            <label class="qa-label" for="qa-new-statement">Pergunta</label>
                            <InputTextArea class="qa-textarea"
                                           id="qa-new-statement"
                                           @bind-Value="_question.Statement"
                                           placeholder="O que é necrose de coagulação?" />
                        </div>

                        <div class="qa-field">
                            <label class="qa-label" for="qa-new-answer">Resposta</label>
                            <InputTextArea class="qa-textarea"
                                           id="qa-new-answer"
                                           @bind-Value="_question.Answer"
                                           placeholder="Morte celular por isquemia com preservação do contorno do tecido." />
                        </div>

                    </div>

                    @if (_topics.Count > 0)
                    {
                        <div class="qa-field" style="margin-top:14px">
                            <label class="qa-label" for="qa-new-topic">Submatéria (opcional)</label>
                            <select class="qa-select"
                                    id="qa-new-topic"
                                    value="@(_question.TopicID?.ToString() ?? "")"
                                    @onchange="OnNewTopicChanged">
                                <option value="">Sem submatéria</option>
                                @foreach (var topic in _topics)
                                {
                                    <option value="@topic.ID">@topic.Name</option>
                                }
                            </select>
                        </div>
                    }

                    <div class="qa-btnrow" style="margin-top:16px">
                        <button type="submit" class="qa-btn qa-btn--primary">
                            <svg class="qa-ico" aria-hidden="true"><use href="#i-plus"></use></svg>
                            Criar pergunta
                        </button>
                        <button type="button" class="qa-btn qa-btn--ghost" @onclick="ClearForm">
                            Limpar
                        </button>
                        <span class="qa-btnrow__spacer"></span>
                        <span class="qa-hint">Uma pergunta, uma resposta. Se a resposta virar lista, quebre em cards separados.</span>
                    </div>

                </div>

            </EditForm>

            @* ── SUBMATÉRIAS NO MOBILE ─────────────────────────────────────
                 Espelho do bloco do painel lateral. Abaixo de 1180px o
                 <aside class="qa-context"> some (app.css) e este assume:
                 mesmos handlers, só o layout muda.
                 Fica recolhido por padrão — o <summary> já mostra qual
                 filtro está ativo, então fechado não esconde informação. *@
            <details class="qa-contextinline qa-plate qa-subtopics">

                <summary class="qa-collapse__head">
                    <span class="qa-eyebrow">Submatérias</span>
                    <span class="qa-collapse__now">@TopicFilterLabel</span>
                    <svg class="qa-ico qa-collapse__chev" aria-hidden="true"><use href="#i-chevron-down"></use></svg>
                </summary>

                <div class="qa-collapse__body">

                    @if (_topics.Count == 0)
                    {
                        <p class="qa-hint">Nenhuma submatéria ainda.</p>
                    }

                    <div class="qa-filters qa-filters--row" style="margin-top:10px">

                        @if (_topics.Count > 0)
                        {
                            <button type="button"
                                    class="qa-filter @(_filterKind == TopicFilterKind.All ? "is-active" : "")"
                                    @onclick="ShowAllTopics">
                                <span class="qa-filter__dot" style="background:var(--qa-primary)"></span>
                                Todas
                                <span class="qa-filter__count">@_questions.Count</span>
                            </button>

                            @foreach (var topic in _topics)
                            {
                                var isActiveM = _filterKind == TopicFilterKind.One && _filterTopicId == topic.ID;
                                var topicCountM = _questions.Count(q => q.TopicID == topic.ID);

                                <button type="button"
                                        class="qa-filter @(isActiveM ? "is-active" : "")"
                                        @onclick="() => FilterByTopic(topic.ID)">
                                    <span class="qa-filter__dot" style="background:var(--qa-subject)"></span>
                                    @topic.Name
                                    <span class="qa-filter__count">@topicCountM</span>
                                </button>
                            }

                            @if (_questions.Any(q => q.TopicID is null))
                            {
                                <button type="button"
                                        class="qa-filter @(_filterKind == TopicFilterKind.None ? "is-active" : "")"
                                        @onclick="FilterWithoutTopic">
                                    <span class="qa-filter__dot" style="background:var(--qa-text-3)"></span>
                                    Sem submatéria
                                    <span class="qa-filter__count">@_questions.Count(q => q.TopicID is null)</span>
                                </button>
                            }
                        }

                        <button type="button"
                                class="qa-filter qa-filter--action"
                                @onclick="OpenTopics">
                            <svg class="qa-ico" aria-hidden="true"><use href="#i-gear"></use></svg>
                            Gerenciar
                        </button>

                    </div>

                </div>

            </details>

            @* ── ESTADO: CARREGANDO ────────────────────────────────────── *@
            @if (_loading)
            {
                <div class="qa-qgrid" aria-hidden="true">
                    @for (var i = 0; i < 3; i++)
                    {
                        <article class="qa-qcard">
                            <span class="qa-skel qa-skel--text" style="width:30%"></span>
                            <span class="qa-skel qa-skel--title" style="width:90%"></span>
                            <span class="qa-skel qa-skel--title" style="width:64%"></span>
                            <span class="qa-skel qa-skel--text" style="width:46%;margin-top:12px"></span>
                        </article>
                    }
                </div>
                <p class="qa-sronly" role="status">Carregando perguntas</p>
            }

            @* ── ESTADO: VAZIO (nenhuma pergunta na matéria) ───────────── *@
            else if (_questions.Count == 0)
            {
                <div class="qa-empty">
                    <div class="qa-empty__icon">
                        <svg class="qa-ico" aria-hidden="true"><use href="#i-question"></use></svg>
                    </div>
                    <h3 class="qa-empty__title">Nenhuma pergunta ainda</h3>
                    <p class="qa-empty__text">
                        Use o formulário acima para escrever a primeira. Assim que
                        existir uma pergunta, o modo de estudo é liberado.
                    </p>
                </div>
            }

            @* ── ESTADO: VAZIO POR FILTRO ──────────────────────────────── *@
            else if (!FilteredQuestions.Any())
            {
                <div class="qa-empty">
                    <div class="qa-empty__icon">
                        <svg class="qa-ico" aria-hidden="true"><use href="#i-search"></use></svg>
                    </div>
                    <h3 class="qa-empty__title">Nenhuma pergunta nesta submatéria</h3>
                    <p class="qa-empty__text">
                        A matéria tem @_questions.Count @(_questions.Count == 1 ? "pergunta" : "perguntas"),
                        mas nenhuma está marcada aqui.
                    </p>
                    <button type="button" class="qa-btn qa-btn--ghost" @onclick="ShowAllTopics"
                            style="margin-top:14px">
                        Ver todas as perguntas
                    </button>
                </div>
            }

            @* ── ESTADO: LISTA ─────────────────────────────────────────── *@
            else
            {
                <div class="qa-qgrid">

                    @{
                        var index = 0;
                    }

                    @foreach (var question in FilteredQuestions)
                    {
                        index++;

                        var visible = _visibleAnswers.Contains(question.ID);
                        var status = StatusOf(question);

                        <article class="qa-qcard @StatusClass(status)">

                            <div class="qa-qcard__top">

                                <span class="qa-qcard__num">#@index.ToString("00")</span>

                                @if (question.TopicID is Guid qTopicId
                                    && _topicNames.TryGetValue(qTopicId, out var qTopicName))
                                {
                                    <span class="qa-chip qa-chip--teal">
                                        <span class="qa-chip__dot" aria-hidden="true"></span>
                                        @qTopicName
                                    </span>
                                }

                                <span class="qa-chip @StatusChipClass(status)" style="margin-left:auto">
                                    <span class="qa-chip__dot" aria-hidden="true"></span>
                                    @if (question.TimesAnswered == 0)
                                    {
                                        <span>Nunca respondida</span>
                                    }
                                    else
                                    {
                                        <span>@question.CorrectAnswers/@question.TimesAnswered</span>
                                    }
                                </span>

                            </div>

                            <h3 class="qa-qcard__statement">@question.Statement</h3>

                            @if (visible)
                            {
                                <div class="qa-qcard__answer">@question.Answer</div>
                            }

                            <div class="qa-qcard__foot">

                                <button type="button"
                                        class="qa-btn qa-btn--ghost qa-btn--sm"
                                        @onclick="() => ToggleAnswer(question.ID)"
                                        aria-expanded="@(visible ? "true" : "false")">
                                    <svg class="qa-ico" aria-hidden="true">
                                        <use href="@(visible ? "#i-eye-off" : "#i-eye")"></use>
                                    </svg>
                                    @(visible ? "Ocultar" : "Ver resposta")
                                </button>

                                <button type="button"
                                        class="qa-btn qa-btn--ghost qa-btn--sm"
                                        @onclick="() => OpenEditModal(question)">
                                    <svg class="qa-ico" aria-hidden="true"><use href="#i-pencil"></use></svg>
                                    Editar
                                </button>

                                <button type="button"
                                        class="qa-btn qa-btn--danger qa-btn--sm"
                                        @onclick="() => AskDelete(question)">
                                    <svg class="qa-ico" aria-hidden="true"><use href="#i-trash"></use></svg>
                                    Excluir
                                </button>

                            </div>

                        </article>
                    }

                </div>
            }

        </div>

    </main>

</div>


@* ═══════════════════ DIÁLOGO: EDITAR PERGUNTA ═══════════════════
   Mesma lógica de antes (editingQuestion + SaveEdit), em um diálogo
   com título, fechamento por clique fora e ações à direita. *@
@if (showEditModal && editingQuestion is not null)
{
    <div class="qa-overlay" @onclick="CloseEditModal">

        <div class="qa-dialog qa-dialog--lg"
             role="dialog"
             aria-modal="true"
             aria-labelledby="qa-edit-title"
             @onclick:stopPropagation="true">

            <div class="qa-dialog__head">
                <h2 class="qa-dialog__title" id="qa-edit-title">Editar pergunta</h2>
                <button type="button"
                        class="qa-btn qa-btn--icon qa-dialog__close"
                        @onclick="CloseEditModal"
                        aria-label="Fechar">
                    <svg class="qa-ico" aria-hidden="true"><use href="#i-x"></use></svg>
                </button>
            </div>

            <div class="qa-dialog__body">

                <div class="qa-field">
                    <label class="qa-label" for="qa-edit-statement">Pergunta</label>
                    <InputTextArea class="qa-textarea"
                                   id="qa-edit-statement"
                                   @bind-Value="editingQuestion.Statement" />
                </div>

                <div class="qa-field">
                    <label class="qa-label" for="qa-edit-answer">Resposta</label>
                    <InputTextArea class="qa-textarea"
                                   id="qa-edit-answer"
                                   @bind-Value="editingQuestion.Answer" />
                </div>

                @if (_topics.Count > 0)
                {
                    <div class="qa-field">
                        <label class="qa-label" for="qa-edit-topic">Submatéria</label>
                        <select class="qa-select"
                                id="qa-edit-topic"
                                value="@(editingQuestion.TopicID?.ToString() ?? "")"
                                @onchange="OnEditTopicChanged">
                            <option value="">Sem submatéria</option>
                            @foreach (var topic in _topics)
                            {
                                <option value="@topic.ID">@topic.Name</option>
                            }
                        </select>
                    </div>
                }

            </div>

            <div class="qa-dialog__foot">
                <button type="button" class="qa-btn qa-btn--ghost" @onclick="CloseEditModal">
                    Cancelar
                </button>
                <button type="button" class="qa-btn qa-btn--primary" @onclick="SaveEdit">
                    <svg class="qa-ico" aria-hidden="true"><use href="#i-check"></use></svg>
                    Salvar
                </button>
            </div>

        </div>
    </div>
}


@* ═══════════════════ DIÁLOGO: CONFIRMAR EXCLUSÃO ═══════════════════ *@
@if (_deleteTarget is not null)
{
    <div class="qa-overlay" @onclick="CancelDelete">

        <div class="qa-dialog qa-dialog--sm qa-dialog--danger"
             role="alertdialog"
             aria-modal="true"
             aria-labelledby="qa-delq-title"
             @onclick:stopPropagation="true">

            <div class="qa-dialog__head">
                <div class="qa-dialog__icon">
                    <svg class="qa-ico" aria-hidden="true"><use href="#i-alert"></use></svg>
                </div>
                <h2 class="qa-dialog__title" id="qa-delq-title">Excluir pergunta?</h2>
            </div>

            <div class="qa-dialog__body">
                <p class="qa-muted">&ldquo;@_deleteTarget.Statement&rdquo;</p>
                <p class="qa-hint">Esta ação não pode ser desfeita.</p>
            </div>

            <div class="qa-dialog__foot">
                <button type="button" class="qa-btn qa-btn--ghost" @onclick="CancelDelete">Cancelar</button>
                <button type="button" class="qa-btn qa-btn--danger-solid" @onclick="ConfirmDelete">
                    <svg class="qa-ico" aria-hidden="true"><use href="#i-trash"></use></svg>
                    Excluir
                </button>
            </div>

        </div>
    </div>
}

@* ═══════════════════ DIÁLOGO: GERENCIAR SUBMATÉRIAS ═══════════════════
   Criar, renomear e excluir. A confirmação de exclusão acontece dentro
   da própria linha, para não empilhar um segundo overlay por cima deste. *@
@if (_showTopics)
{
    <div class="qa-overlay" @onclick="CloseTopics">

        <div class="qa-dialog qa-dialog--lg"
             role="dialog"
             aria-modal="true"
             aria-labelledby="qa-topics-title"
             @onclick:stopPropagation="true">

            <div class="qa-dialog__head">
                <h2 class="qa-dialog__title" id="qa-topics-title">Submatérias de @_subject.Name</h2>
                <button type="button"
                        class="qa-btn qa-btn--icon qa-dialog__close"
                        @onclick="CloseTopics"
                        aria-label="Fechar">
                    <svg class="qa-ico" aria-hidden="true"><use href="#i-x"></use></svg>
                </button>
            </div>

            <div class="qa-dialog__body">

                @* ── CRIAR ──────────────────────────────────────────── *@
                <div class="qa-field">
                    <label class="qa-label" for="qa-new-topic-name">Nova submatéria</label>
                    <div class="qa-row">
                        <input class="qa-input"
                               id="qa-new-topic-name"
                               @bind="_newTopicName"
                               @bind:event="oninput"
                               @onkeydown="OnNewTopicKeyDown"
                               placeholder="Ex.: SP1" />
                        <button type="button"
                                class="qa-btn qa-btn--primary"
                                disabled="@string.IsNullOrWhiteSpace(_newTopicName)"
                                @onclick="CreateTopic">
                            <svg class="qa-ico" aria-hidden="true"><use href="#i-plus"></use></svg>
                            Criar
                        </button>
                    </div>
                    <span class="qa-hint">Nomes se repetem entre matérias, mas não dentro da mesma.</span>
                </div>

                @* ── LISTA ──────────────────────────────────────────── *@
                @if (_topics.Count == 0)
                {
                    <p class="qa-muted" style="margin-top:18px">
                        Esta matéria ainda não tem submatérias. Perguntas sem submatéria
                        continuam funcionando normalmente.
                    </p>
                }
                else
                {
                    <div style="margin-top:18px;display:flex;flex-direction:column;gap:8px">

                        @foreach (var topic in _topics)
                        {
                            var used = _questions.Count(q => q.TopicID == topic.ID);

                            <div class="qa-plate">

                                @* MODO: RENOMEANDO *@
                                @if (_renamingTopicId == topic.ID)
                                {
                                    <div class="qa-row">
                                        <input class="qa-input"
                                               @bind="_renamingName"
                                               @bind:event="oninput" />
                                        <button type="button"
                                                class="qa-btn qa-btn--primary qa-btn--sm"
                                                @onclick="() => ConfirmRename(topic)">
                                            <svg class="qa-ico" aria-hidden="true"><use href="#i-check"></use></svg>
                                            Salvar
                                        </button>
                                        <button type="button"
                                                class="qa-btn qa-btn--ghost qa-btn--sm"
                                                @onclick="CancelRename">
                                            Cancelar
                                        </button>
                                    </div>
                                }

                                @* MODO: CONFIRMANDO EXCLUSÃO *@
                                else if (_topicDeleteId == topic.ID)
                                {
                                    <div class="qa-row qa-row--between qa-row--wrap">
                                        <div style="min-width:0">
                                            <strong>Excluir &ldquo;@topic.Name&rdquo;?</strong>
                                            <p class="qa-hint" style="margin:4px 0 0">
                                                @if (used == 0)
                                                {
                                                    <span>Nenhuma pergunta usa esta submatéria.</span>
                                                }
                                                else
                                                {
                                                    <span>
                                                        @used @(used == 1 ? "pergunta volta" : "perguntas voltam")
                                                        para &ldquo;sem submatéria&rdquo;. Nenhuma pergunta é apagada.
                                                    </span>
                                                }
                                            </p>
                                        </div>
                                        <div class="qa-row">
                                            <button type="button"
                                                    class="qa-btn qa-btn--ghost qa-btn--sm"
                                                    @onclick="CancelDeleteTopic">
                                                Cancelar
                                            </button>
                                            <button type="button"
                                                    class="qa-btn qa-btn--danger-solid qa-btn--sm"
                                                    @onclick="() => ConfirmDeleteTopic(topic.ID)">
                                                <svg class="qa-ico" aria-hidden="true"><use href="#i-trash"></use></svg>
                                                Excluir
                                            </button>
                                        </div>
                                    </div>
                                }

                                @* MODO: NORMAL *@
                                else
                                {
                                    <div class="qa-row qa-row--between qa-row--wrap">
                                        <div class="qa-row" style="min-width:0">
                                            <span class="qa-chip qa-chip--teal">
                                                <span class="qa-chip__dot" aria-hidden="true"></span>
                                                @topic.Name
                                            </span>
                                            <span class="qa-hint">
                                                @used @(used == 1 ? "pergunta" : "perguntas")
                                            </span>
                                        </div>
                                        <div class="qa-row">
                                            <button type="button"
                                                    class="qa-btn qa-btn--ghost qa-btn--sm"
                                                    @onclick="() => StartRename(topic)">
                                                <svg class="qa-ico" aria-hidden="true"><use href="#i-pencil"></use></svg>
                                                Renomear
                                            </button>
                                            <button type="button"
                                                    class="qa-btn qa-btn--danger qa-btn--sm"
                                                    @onclick="() => AskDeleteTopic(topic.ID)">
                                                <svg class="qa-ico" aria-hidden="true"><use href="#i-trash"></use></svg>
                                                Excluir
                                            </button>
                                        </div>
                                    </div>
                                }

                            </div>
                        }

                    </div>
                }

            </div>

            <div class="qa-dialog__foot">
                <button type="button" class="qa-btn qa-btn--ghost" @onclick="CloseTopics">
                    Fechar
                </button>
            </div>

        </div>
    </div>
}


@code {

    [Parameter]
    public Guid Id { get; set; }

    // ── ESTADO ORIGINAL (preservado) ─────────────────────────────────────
    private List<Question> _questions = [];
    private Question _question = new();
    private Subject _subject = new();

    private bool showEditModal;
    private Question? editingQuestion;

    private HashSet<Guid> _visibleAnswers = [];

    // ── ESTADO NOVO, SOMENTE DE INTERFACE ────────────────────────────────
    private bool _loading = true;
    private Question? _deleteTarget;

    // ── SUBMATÉRIAS ──────────────────────────────────────────────────────
    private List<Topic> _topics = [];
    private Dictionary<Guid, string> _topicNames = new();

    // O filtro tem TRÊS estados, então os três têm nome.
    private enum TopicFilterKind { All, One, None }
    private TopicFilterKind _filterKind = TopicFilterKind.All;
    private Guid _filterTopicId;

    // Diálogo de gerenciamento
    private bool _showTopics;
    private string _newTopicName = string.Empty;
    private Guid? _renamingTopicId;
    private string _renamingName = string.Empty;
    private Guid? _topicDeleteId;

    /// <summary>
    /// Recorte da lista conforme o filtro. Filtra em memória de propósito:
    /// as perguntas da matéria já vieram todas no GetQuestions(), então
    /// filtrar por submatéria não justifica outra ida ao servidor.
    /// </summary>
    private IEnumerable<Question> FilteredQuestions => _filterKind switch
    {
        TopicFilterKind.One => _questions.Where(q => q.TopicID == _filterTopicId),
        TopicFilterKind.None => _questions.Where(q => q.TopicID is null),
        _ => _questions
    };

    /// <summary>
    /// Rótulo do filtro atual, exibido no cabeçalho recolhido das
    /// submatérias no mobile — para o bloco fechado não esconder
    /// qual recorte está valendo. Usa _topicNames, que já é montado
    /// em LoadTopics().
    /// </summary>
    private string TopicFilterLabel => _filterKind switch
    {
        TopicFilterKind.One => _topicNames.TryGetValue(_filterTopicId, out var name) ? name : "Todas",
        TopicFilterKind.None => "Sem submatéria",
        _ => "Todas"
    };

    // ══════════════════════════════════════════════════════════════════════
    // CICLO DE VIDA / DADOS — INALTERADO
    // ══════════════════════════════════════════════════════════════════════
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        await GetQuestions();
        await GetTopics();

        _subject = await SubjectService.GetAsync(Id) ?? new();

        _loading = false;

        StateHasChanged();
    }

    protected async Task<List<Question>> GetQuestions()
    {
        _questions = await QuestionService.GetAllAsync(Id);

        StateHasChanged();

        return _questions;
    }

    protected async Task CreateQuestion()
    {
        if (string.IsNullOrWhiteSpace(_question.Statement))
            return;

        _question.SubjectID = Id;
        _question.CreatedAt = DateTime.UtcNow;

        await QuestionService.CreateAsync(_question);

        // Mantém a submatéria selecionada para a próxima pergunta: quem está
        // cadastrando 15 questões da SP1 não quer reescolher a cada uma.
        var lastTopic = _question.TopicID;

        _question = new Question { TopicID = lastTopic };

        await GetQuestions();
    }

    protected async Task DeleteQuestion(Guid id)
    {
        await QuestionService.DeleteAsync(id);

        await GetQuestions();
    }

    private void OpenEditModal(Question question)
    {
        // A cópia precisa levar TODAS as colunas. QuestionService.UpdateAsync
        // manda o modelo inteiro no PATCH — qualquer campo que não for copiado
        // aqui vai para o banco como default (0, false, Guid.Empty) e sobrescreve
        // o valor real.
        editingQuestion = new Question
        {
            ID = question.ID,
            Statement = question.Statement,
            Answer = question.Answer,
            TimesAnswered = question.TimesAnswered,
            CorrectAnswers = question.CorrectAnswers,
            LastAnswerCorrect = question.LastAnswerCorrect,
            CreatedAt = question.CreatedAt,
            LastReview = question.LastReview,
            SubjectID = question.SubjectID,
            TopicID = question.TopicID,
            UserId = question.UserId
        };

        showEditModal = true;
    }

    private void CloseEditModal()
    {
        showEditModal = false;
        editingQuestion = null;
    }

    private async Task SaveEdit()
    {
        if (editingQuestion is null)
            return;

        await QuestionService.UpdateAsync(editingQuestion);

        showEditModal = false;
        editingQuestion = null;

        await GetQuestions();
    }

    private void ToggleAnswer(Guid id)
    {
        if (!_visibleAnswers.Add(id))
            _visibleAnswers.Remove(id);
    }


    // ══════════════════════════════════════════════════════════════════════
    // INTERFACE (sem regra de negócio)
    // ══════════════════════════════════════════════════════════════════════
    private void Study()
    {
        Navigation.NavigateTo($"/cards/{Id}");
    }

    private void ClearForm()
    {
        _question = new();
    }

    private void AskDelete(Question question)
    {
        _deleteTarget = question;
    }

    private void CancelDelete()
    {
        _deleteTarget = null;
    }

    private async Task ConfirmDelete()
    {
        if (_deleteTarget is null)
            return;

        var id = _deleteTarget.ID;

        _deleteTarget = null;

        await DeleteQuestion(id);   // método original, intacto
    }


    // ══════════════════════════════════════════════════════════════════════
    // APRESENTAÇÃO: estado visual da pergunta
    // Lê apenas campos que já vêm carregados no objeto Question.
    // ══════════════════════════════════════════════════════════════════════
    private enum QuestionStatus { New, Correct, Wrong }

    private static QuestionStatus StatusOf(Question q)
        => q.TimesAnswered == 0 ? QuestionStatus.New
         : q.LastAnswerCorrect ? QuestionStatus.Correct
         : QuestionStatus.Wrong;

    private static string StatusClass(QuestionStatus s) => s switch
    {
        QuestionStatus.New => "qa-qcard--new",
        QuestionStatus.Correct => "qa-qcard--ok",
        _ => "qa-qcard--bad"
    };

    private static string StatusChipClass(QuestionStatus s) => s switch
    {
        QuestionStatus.New => "qa-chip--warning",
        QuestionStatus.Correct => "qa-chip--success",
        _ => "qa-chip--danger"
    };
    
    private int? GetMastery()
    {
        var totalTimesAnwered = _questions.Sum(q => q.TimesAnswered);
        
        if (totalTimesAnwered == 0)
            return 0;

        var totalCorrectAnswers = _questions.Sum(q => q.CorrectAnswers);
        
        return (totalCorrectAnswers * 100) / totalTimesAnwered;
    }

    private int? GetWrongCount()
    {
        return _questions.Count(q => q.TimesAnswered > 0 && !q.LastAnswerCorrect);
    }

    private int? GetNeverAnsweredCount()
    {
        return _questions.Count(q => q.TimesAnswered == 0);
    }

    // ══════════════════════════════════════════════════════════════════════
    // SUBMATÉRIAS
    // ══════════════════════════════════════════════════════════════════════
    private async Task GetTopics()
    {
        _topics = await TopicService.GetAllAsync(Id);
        _topicNames = _topics.ToDictionary(t => t.ID, t => t.Name);

        // Se a submatéria filtrada deixou de existir (excluída agora, ou em
        // outra aba), o filtro apontaria para o nada e a lista ficaria vazia
        // sem explicação. Volta para "Todas".
        if (_filterKind == TopicFilterKind.One && !_topicNames.ContainsKey(_filterTopicId))
            _filterKind = TopicFilterKind.All;

        StateHasChanged();
    }

    private void ShowAllTopics()
    {
        _filterKind = TopicFilterKind.All;
    }

    private void FilterByTopic(Guid topicId)
    {
        _filterKind = TopicFilterKind.One;
        _filterTopicId = topicId;
    }

    private void FilterWithoutTopic()
    {
        _filterKind = TopicFilterKind.None;
    }

    private static Guid? ParseTopicValue(object? raw)
    {
        var text = raw?.ToString();

        return string.IsNullOrEmpty(text) ? null : Guid.Parse(text);
    }

    private void OnNewTopicChanged(ChangeEventArgs e)
    {
        _question.TopicID = ParseTopicValue(e.Value);
    }

    private void OnEditTopicChanged(ChangeEventArgs e)
    {
        if (editingQuestion is not null)
            editingQuestion.TopicID = ParseTopicValue(e.Value);
    }

    private void OpenTopics()
    {
        _newTopicName = string.Empty;
        _renamingTopicId = null;
        _topicDeleteId = null;
        _showTopics = true;
    }

    private void CloseTopics()
    {
        _showTopics = false;
    }

    private async Task OnNewTopicKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await CreateTopic();
    }

    private async Task CreateTopic()
    {
        var name = _newTopicName.Trim();

        if (string.IsNullOrWhiteSpace(name))
            return;

        await TopicService.CreateAsync(new Topic
        {
            SubjectID = Id,
            Name = name,
            Position = _topics.Count
        });

        _newTopicName = string.Empty;

        await GetTopics();
    }

    private void StartRename(Topic topic)
    {
        _topicDeleteId = null;
        _renamingTopicId = topic.ID;
        _renamingName = topic.Name;
    }

    private void CancelRename()
    {
        _renamingTopicId = null;
        _renamingName = string.Empty;
    }

    private async Task ConfirmRename(Topic topic)
    {
        var name = _renamingName.Trim();

        if (string.IsNullOrWhiteSpace(name) || name == topic.Name)
        {
            CancelRename();
            return;
        }

        topic.Name = name;

        await TopicService.UpdateAsync(topic);

        CancelRename();

        await GetTopics();
    }

    private void AskDeleteTopic(Guid id)
    {
        _renamingTopicId = null;
        _topicDeleteId = id;
    }

    private void CancelDeleteTopic()
    {
        _topicDeleteId = null;
    }

    private async Task ConfirmDeleteTopic(Guid id)
    {
        _topicDeleteId = null;

        await TopicService.DeleteAsync(id);

        await GetTopics();
        await GetQuestions();
    }
}
